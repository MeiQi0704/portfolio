---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="about-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-image">
          <img src="/images/Me.jpeg" alt="Kiki Leow Mei Qi" />
        </div>
        <div class="about-content">
          <h1>About Me</h1>
          <p class="intro">
            Hello! I'm Kiki Leow Mei Qi.
          </p>
          <p>
            I am an undergraduate student pursuing a Bachelor of Engineering (Hons) in Digital Media Technology at Xiamen University Malaysia, specializing in <strong>game development</strong>, <strong>programming</strong>, and <strong>cutscene design</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-section {
    padding: var(--spacing-xl) 0;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .about-grid {
    display: flex;
    gap: 6rem; /* Increased spacing */
    align-items: center;
    justify-content: center;
  }

  .about-image {
    flex: 1;
    max-width: 400px;
  }

  .about-image img {
    width: 100%;
    height: 100%;
    aspect-ratio: 3/4; /* Standard portrait ratio */
    object-fit: cover;
    object-position: center 30%; /* Visually crops/shifts focus */
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md);
    display: block;
  }

  .about-content {
    flex: 1;
    text-align: left; /* Changed from center to left for side-by-side */
  }

  h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-lg);
    color: var(--color-text);
  }

  p {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: var(--spacing-md);
    line-height: 1.8;
  }

  .intro {
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-secondary);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .about-grid {
      flex-direction: column;
      text-align: center; /* Center on mobile */
    }

    .about-content {
      text-align: center;
    }
    
    .about-image {
      max-width: 100%;
      width: 80%; /* Don't be too huge on mobile */
    }
  }
</style>
