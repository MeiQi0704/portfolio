---
import Layout from '../../layouts/Layout.astro';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout>
  <div class="project-page">
    <div class="container">
      <a href="/" class="back-link">&larr; Back to Portfolio</a>
      
      <article class="project-content">
        <header class="project-header">
          <h1>{project.title}</h1>
          <p class="project-description">{project.description}</p>
        </header>

        <div class="video-container">
          <video controls poster="https://via.placeholder.com/1280x720/cbbca0/4a453e?text=Video+Placeholder" class="project-video">
             <source src={project.videoUrl} type="video/mp4" />
             Your browser does not support the video tag.
          </video>
        </div>

        <div class="project-details">
          <div class="detail-block">
             <h3>About this Project</h3>
             <p>
               This is a placeholder description for {project.title}. In a real application, 
               this would contain detailed case study information, process shots, and 
               conceptual background. The design follows the earth-tone aesthetic with 
               warm colors and clean typography.
             </p>
             <p>
               Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod 
               tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, 
               quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
             </p>
          </div>
        </div>
      </article>
    </div>
  </div>
</Layout>

<style>
  .project-page {
    padding: var(--spacing-xl) 0;
    min-height: 100vh;
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--spacing-lg);
    font-weight: 700;
    color: var(--color-primary);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .project-header {
    margin-bottom: var(--spacing-lg);
    max-width: 800px;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-sm);
  }

  .project-description {
    font-size: 1.25rem;
    color: rgba(74, 69, 62, 0.8);
  }

  .video-container {
    width: 100%;
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    margin-bottom: var(--spacing-xl);
    background: #000;
  }

  .project-video {
    width: 100%;
    display: block;
    aspect-ratio: 16/9;
  }

  .project-details {
    max-width: 800px;
    margin: 0 auto;
  }

  .detail-block h3 {
    font-size: 1.5rem;
    margin-bottom: var(--spacing-md);
    color: var(--color-secondary);
  }

  .detail-block p {
    margin-bottom: var(--spacing-md);
  }
</style>
