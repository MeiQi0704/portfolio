<style>
  .site-footer {
    background-color: var(--color-text); /* Theme color (dark brown) */
    color: #fff; /* White text */
    padding: var(--spacing-xl) 0;
    width: 100%;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end; /* Align bottom */
    }

    .footer-left {
      max-width: 50%;
    }

    .footer-right {
      text-align: right;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: var(--spacing-sm);
    }
  }

  .contact-info p {
    margin: 0 0 var(--spacing-sm) 0;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
  }

  .copyright {
    font-size: 0.9rem;
    opacity: 0.6;
  }
</style>
