---
import projects from '../data/projects.json';

// Truncate description for the card view
const truncate = (str: string, max: number) => str.length > max ? str.slice(0, max) + "..." : str;

const CATEGORIES = [
  "Unity",
  "Unreal Engine",
  "Game Cutscene / Timeline",
  "AR",
  "VR",
  "Animation",
  "Modelling",
  "Video",
  "Audio"
];

// Group projects by category
const projectsByCategory = CATEGORIES.reduce((acc, category) => {
  acc[category] = projects.filter(p => p.category === category);
  return acc;
}, {} as Record<string, typeof projects>);

// Filter out empty categories for rendering
const activeCategories = CATEGORIES.filter(cat => projectsByCategory[cat].length > 0);
---

<section id="portfolio" class="portfolio-section">
  <div class="container">

    {activeCategories.map((category) => (
      <div class="category-section">
        <h3 class="category-title">{category}</h3>
        <div class="project-grid">
          {projectsByCategory[category].map((project) => (
            <a href={`/projects/${project.id}`} class="project-card">
              {project.image ? (
                <div class="card-image-container">
                  <img src={project.image} alt={project.title} class="card-image" />
                </div>
              ) : (
                <div class="card-image-placeholder">
                  <span class="placeholder-icon">video</span>
                </div>
              )}
              <div class="card-content">
                <h3>{project.title}</h3>
                <!-- <p>{truncate(project.description, 60)}</p> -->
                <span class="read-more">View Project &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .portfolio-section {
    padding: var(--spacing-xl) 0;
    position: relative;
  }


  .category-section {
    margin-bottom: var(--spacing-xxl);
  }

  .category-title {
    font-size: 2.2rem;
    color: var(--color-text);
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--spacing-lg);
  }

  @media (min-width: 600px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-card {
    background: var(--color-surface);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-soft);
  }

  .card-image-placeholder {
    width: 100%;
    aspect-ratio: 16/9;
    background-color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-bg);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    opacity: 0.8;
  }

  .card-content {
    padding: var(--spacing-md) var(--spacing-md) var(--spacing-lg);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .card-content p {
    font-size: 0.95rem;
    color: rgba(74, 69, 62, 0.8);
    margin-bottom: var(--spacing-md);
    flex-grow: 1;
  }

  .card-image-container {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    position: relative;
    background-color: var(--color-surface);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .project-card:hover .card-image {
    transform: scale(1.05);
  }

  .read-more {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
