---
<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1>My Portfolio</h1>
      <p class="subtitle">Welcome to my portfolio. <br/> Here you’ll find a curated selection of my work.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-text); /* Dark Brown Background */
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, var(--color-accent) 0%, rgba(203, 188, 160, 0) 70%);
    top: -20%;
    right: -20%;
    opacity: 0.15; /* Reduced opacity for better contrast */
    filter: blur(80px);
    border-radius: 50%;
  }

  .hero::after {
    content: '';
    position: absolute;
    width: 40%;
    height: 40%;
    background: radial-gradient(circle, var(--color-secondary) 0%, rgba(166, 124, 109, 0) 70%);
    bottom: -10%;
    left: -10%;
    opacity: 0.15; /* Reduced opacity for better contrast */
    filter: blur(80px);
    border-radius: 50%;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  h1 {
    font-size: 3.5rem;
    line-height: 1.1;
    margin-bottom: var(--spacing-lg);
    letter-spacing: -0.02em;
    color: var(--color-bg); /* Light Text */
  }

  .subtitle {
    font-size: 1.25rem;
    color: rgba(253, 252, 248, 0.8); /* Light Text with opacity */
    max-width: 500px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 5rem;
    }
  }
</style>
